#version 450
#extension GL_EXT_shader_atomic_int64 : require

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

// Constants
#define MAX_QUEUE_SIZE 65536
#define INVALID_INDEX 0xFFFFFFFF

// RuntimeBVH node
struct Node {
    vec4 bounding_sphere; // xyz = center, w = radius
    uint node_index;
    uint group_index;
    float error;
};

struct Group {
    int child_node_indices[8];
};

struct ResultPair {
    uint node_index;
    uint lod_level;
};

// Input buffers
layout(set=0, binding=0, std140) readonly buffer Clusters {
    Node clusters[];
};

layout(set=0, binding=1, std140) readonly buffer Groups {
    Group groups[];
};

layout(set=0, binding=2, std140) readonly buffer ObjectOffsets {
    uint root_nodes[];
};

